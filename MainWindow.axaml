<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="390" d:DesignHeight="844"
        x:Class="RecorderMockup.MainWindow"
        Title="RecorderMockup"
        Width="390" Height="844"
        Background="#D6D6D6"
        CanResize="False">



        <Canvas>
                <!--Buttons layed out below using canvas to choose the exact position -->
                <Button Classes="record" Canvas.Left="227" 
                        Canvas.Top="254"/> 
            
                <Button Classes="back" Canvas.Left="20"
                        Canvas.Top="577"/>

                <Button Classes="forward" Canvas.Left="204"
                        Canvas.Top="577"/>

        </Canvas>


</Window>
